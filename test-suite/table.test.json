{
  "source": "https://github.com/tabular-json/tabular-json/blob/v2.0.0/test-suite/table.test.json",
  "groups": [
    {
      "description": "should test whether an array contains tabular data",
      "function": "isTable",
      "tests": [
        { "input": [], "output": false },
        { "input": [1, 2, 3], "output": false },
        { "input": ["text"], "output": false },
        { "input": [{}, []], "output": false },
        { "input": [{}, 2, {}], "output": false },
        { "input": [{}, null, {}], "output": false },
        { "input": {}, "output": false },
        { "input": "text", "output": false },
        { "input": [{}], "output": true },
        { "input": [{}, {}], "output": true },
        { "input": [{ "a": 2 }, { "b": 3 }, { "c": 3 }], "output": true }
      ]
    },
    {
      "description": "should test whether a table does not contain nested arrays",
      "function": "noNestedArrays",
      "tests": [
        { "input": [{}], "output": true },
        { "input": [{ "x": 3 }], "output": true },
        { "input": [{ "nested": { "x": 3 } }], "output": true },
        { "input": [{}, { "x": 3 }], "output": true },
        { "input": [{}, { "scores": [4, 5] }], "output": false },
        { "input": [{ "scores": [{ "value": 2 }] }], "output": false },
        { "input": [{}, { "scores": [{ "value": 2 }] }], "output": false },
        {
          "input": [{}, { "nested": { "scores": [{ "value": 2 }] } }],
          "output": false
        },
        { "input": [{}, { "nested": { "scores": [2, 3] } }], "output": false }
      ]
    },
    {
      "description": "should test whether a table does not contain nested tables",
      "function": "noNestedTables",
      "tests": [
        { "input": [{}], "output": true },
        { "input": [{ "x": 3 }], "output": true },
        { "input": [{ "nested": { "x": 3 } }], "output": true },
        { "input": [{}, { "x": 3 }], "output": true },
        { "input": [{}, { "scores": [4, 5] }], "output": true },
        { "input": [{ "scores": [{ "value": 2 }] }], "output": false },
        { "input": [{}, { "scores": [{ "value": 2 }] }], "output": false },
        {
          "input": [{}, { "nested": { "scores": [{ "value": 2 }] } }],
          "output": false
        },
        { "input": [{}, { "nested": { "scores": [2, 3] } }], "output": true }
      ]
    },
    {
      "description": "should test whether a table contains homogeneous data",
      "function": "isHomogeneous",
      "tests": [
        { "input": [{}, {}, {}], "output": true },
        { "input": [{ "a": 2 }, { "a": 3 }, { "a": 4 }], "output": true },
        { "input": [{ "a": 2 }, { "b": 3 }], "output": false },
        { "input": [{ "a": 2 }, { "a": 3 }, { "b": 4 }], "output": false },
        { "input": [{ "a": 2 }, { "b": null }], "output": false }
      ]
    },
    {
      "description": "should test whether a table does not contain values with long strings",
      "function": "noLongStrings",
      "tests": [
        { "input": [{}, {}], "output": true },
        { "input": [{ "value": 2 }, { "value": 3 }], "output": true },
        { "input": [{ "comment": "bla" }], "output": true },
        { "input": [{ "comment": "123456789012345678901234567890" }], "output": false },
        { "input": [{}, {}, { "comment": "123456789012345678901234567890" }], "output": false },
        {
          "input": [{ "nested": { "comment": "123456789012345678901234567890" } }],
          "output": false
        }
      ]
    },
    {
      "description": "should collect the table fields from an array with tabular data",
      "function": "collectFields",
      "tests": [
        { "input": [{}], "output": [] },
        { "input": [{ "": 1 }], "output": [[""]] },
        { "input": [{ "a": 1 }, { "a": 2 }], "output": [["a"]] },
        { "input": [{ "a": 1 }, { "b": 2 }], "output": [["a"], ["b"]] },
        { "input": [{ "a": 1 }, { "nested": { "b": 2 } }], "output": [["a"], ["nested", "b"]] },
        { "input": [{ "a": 1 }, { "a": { "nested": 2 } }], "output": [["a"]] },
        { "input": [{ "a": { "nested": 2 } }, { "a": 1 }], "output": [["a"]] },
        { "input": [{ "a": [1, 2, 3] }], "output": [["a"]] },
        { "input": [{ "a": [{ "b": 2 }] }], "output": [["a"]] },
        { "input": [{ "a": null }], "output": [["a"]] },
        { "input": [{ "a": null }, { "a": { "nested": 2 } }], "output": [["a", "nested"]] }
      ]
    }
  ]
}
