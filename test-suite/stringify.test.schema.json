{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://github.com/tabular-json/tabular-json/blob/v1.1.3/test-suite/stringify.test.json",
  "type": "object",
  "properties": {
    "source": {
      "const": "https://github.com/tabular-json/tabular-json/blob/v1.1.3/test-suite/stringify.test.json"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": { "type": "string" },
          "description": { "type": "string" },
          "options": {
            "type": "object",
            "properties": {
              "indentation": {
                "oneOf": [{ "type": "number" }, { "type": "string" }]
              },
              "trailingZeros": { "type": "boolean" }
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "input": {},
                    "output": { "type": "string" }
                  },
                  "required": ["input", "output"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "input_enum": {
                      "enum": [
                        "negative_zero",
                        "positive_infinity",
                        "negative_infinity",
                        "not_a_number"
                      ]
                    },
                    "output": { "type": "string" }
                  },
                  "required": ["input_enum", "output"],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": ["category", "description", "tests"],
        "additionalProperties": false
      }
    }
  },
  "required": ["source", "groups"],
  "additionalProperties": false
}
